NODE_ENV=production
PORT=3000

# Public base URL used in email links (same value as Laravel APP_URL).
APP_URL=https://approval.property365.co.id:4421/approval_jiexpo

# SQL Server (Laravel "jiexpo" connection)
DB_HOST=sql.ifca.co.id
DB_PORT=1222
DB_DATABASE=JIE_DEMO_UAT
DB_USERNAME=mgr
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@ifca.co.id
MAIL_PASSWORD=
# tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@ifca.co.id
MAIL_FROM_NAME=IFCA SOFTWARE

# Runtime storage (mail de-duplication markers and channel logs)
STORAGE_PATH=./storage

# /api/fileexist FTP check (defaults to the values hard-coded in the PHP app)
FILEEXIST_FTP_HOST=
FILEEXIST_FTP_PORT=
FILEEXIST_FTP_USER=
FILEEXIST_FTP_PASSWORD=
