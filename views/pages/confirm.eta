<%/*
  Confirmation form (replaces every passcheck*.blade.php variant).
  Data: action, status, doc_no, encrypt, email, valuebt, bgcolor, entity_name,
        module?, reasonOnApprove ('none' | 'comment' | 'hidden'), showReason (bool).
*/%>
<% layout('/layouts/page') %>
<img class="state" src="<%= asset('images/double_approve.png') %>" alt="Verified">
<p>Do you want to <%= it.valuebt %> this request ?</p>
<form method="POST" action="<%= url(it.action) %>">
  <input type="hidden" name="status" value="<%= it.status %>">
  <input type="hidden" name="doc_no" value="<%= it.doc_no %>">
  <input type="hidden" name="encrypt" value="<%= it.encrypt %>">
  <input type="hidden" name="email" value="<%= it.email %>">
  <% if (it.module) { %>
  <input type="hidden" name="module" value="<%= it.module %>">
  <% } %>
  <% if (it.showReason) { %>
    <% if (it.status === 'R') { %>
      <p>Please provide the reasons for requesting this revision</p>
      <textarea id="reason" name="reason" rows="3"></textarea>
    <% } else if (it.status === 'A') { %>
      <% if (it.reasonOnApprove === 'comment') { %>
        <p>Add Comment</p>
        <textarea id="reason" name="reason" rows="3"></textarea>
      <% } else if (it.reasonOnApprove === 'hidden') { %>
        <input type="hidden" name="reason" value="no note">
      <% } %>
    <% } else { %>
      <p>Please provide the reasons for requesting the cancellation of this revision</p>
      <textarea id="reason" name="reason" rows="3"></textarea>
    <% } %>
  <% } %>
  <input type="submit" class="btn" style="background-color:<%= it.bgcolor %>" value="<%= it.valuebt %>">
</form>
