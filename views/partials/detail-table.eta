<%/* Label : value table. Data: rows ([label, value][]); rows with value === undefined are skipped. */%>
<table role="presentation" cellpadding="4" cellspacing="0" border="0" width="100%" style="font-size:14px; color:#000000; margin:0 0 15px;">
<% for (const [label, value] of it.rows.filter((r) => r[1] !== undefined)) { %>
  <tr><td width="40%" style="vertical-align:top;"><%= label %></td><td width="2%" style="vertical-align:top;">:</td><td><%= value %></td></tr>
<% } %>
</table>
