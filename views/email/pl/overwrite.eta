<%/* Overwrite Actual Inventory (ploverwrite). Ported from email/ploverwritemail/send.blade.php. */%>
<% layout('/layouts/email') %>
<p style="margin:0 0 15px;">Dear <%= it.user_name %>,</p>
<p style="margin:0 0 15px;">Below is a Overwrite Actual Inventory that requires your approval :</p>
<%~ include('/partials/detail-table', { rows: [['Lot No.', it.doc_no], ['Amount', 'Rp. ' + it.amount]] }) %>
<%~ include('/partials/action-buttons', { link: it.link, encrypt: it.encrypt }) %>
<%~ include('/partials/signature', it) %>
<%~ include('/partials/approvers', { list: it.approve_list }) %>
