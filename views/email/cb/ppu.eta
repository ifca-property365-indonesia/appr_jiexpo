<%/* Payment Request (CB PPU / PPU VVIP). Ported from email/cbppu/send.blade.php. */%>
<% layout('/layouts/email') %>
<p style="margin:0 0 15px;">Dear <%= it.user_name %>,</p>
<p style="margin:0 0 15px;">Below is a request payment that requires your approval :</p>
<p style="margin:0 0 15px;">
  <b><%= it.ppu_descs %></b><br>
  Pay To: <%= it.pay_to %><br>
  With a total amount of <%= it.forex %> <%= it.ppu_amt %><br>
  Request no : <%= it.ppu_no %><br>
</p>
<%~ include('/partials/attachments', { attachments: it.attachments, intro: 'To view a detailed request for payment, please click on the link below :' }) %>
<% if (isFilled(it.doc_link) && /^https?:\/\//.test(it.doc_link)) { %>
<p style="margin:0 0 15px;">This request to purchase comes with additional supporting documents, such as detailed specifications, that you can access from the link below :<br>
  <a href="<%= it.doc_link %>" target="_blank" style="color:#026735;">Additional Document Link</a>
</p>
<% } %>
<%~ include('/partials/action-buttons', { link: it.link, encrypt: it.encrypt }) %>
<%~ include('/partials/signature', it) %>
<%~ include('/partials/approvers', { list: it.approve_list }) %>
