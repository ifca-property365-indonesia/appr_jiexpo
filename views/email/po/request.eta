<%/* Purchase Requisition (PoRequest, via /api/maildata). Ported from email/por/send.blade.php. */%>
<% layout('/layouts/email') %>
<h5 style="font-size:20px; font-weight:400; margin:0 0 15px;">Dear <%= it.user_name %>,</h5>
<p style="margin:0 0 15px;">Below is a request to purchase that requires your approval :</p>
<p style="margin:0 0 15px;">
  <b><%= it.req_hd_descs %></b><br>
  With a total estimated amount of <%= it.curr_cd %> <%= it.total_price %><br>
  RF No.: <%= it.req_hd_no %><br>
</p>
<%~ include('/partials/attachments', { attachments: it.attachments, intro: 'To view a detailed product list, description, and estimate price per item, please click on the link below :' }) %>
<%~ include('/email/po/doc-links', { links: it.doc_links }) %>
<%~ include('/partials/action-buttons', { link: it.link, encrypt: it.encrypt }) %>
<%~ include('/partials/signature', it) %>
<%~ include('/partials/approvers', { list: it.approve_list }) %>
