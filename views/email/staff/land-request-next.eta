<%/*
  Land Request forwarded to finance after final approval (SendNextLandReqeuest).
  Ported from email/landrequestmail/terusan.blade.php.
  Data: entity_name, user_name, detail_text, doc_no, type[], request_amt[], attachments,
        clarify_user, clarify_email, sender_name, sender_addr, approve_list.
*/%>
<% layout('/layouts/email') %>
<h5 style="font-size:20px; font-weight:400; margin:0 0 15px;">Dear <%= it.user_name %>,</h5>
<p style="margin:0 0 15px;"><%= it.detail_text %></p>
<table role="presentation" cellpadding="4" cellspacing="0" border="0" width="100%" style="font-size:14px; color:#000000; margin:0 0 15px;">
  <tr>
    <th style="border:1px solid #000000; text-align:center; padding:8px;">Nomor Dokumen</th>
    <th style="border:1px solid #000000; text-align:center; padding:8px;">Rincian Pengajuan</th>
    <th style="border:1px solid #000000; text-align:center; padding:8px;">Nominal Pengajuan</th>
  </tr>
<% (it.type || []).forEach((type, i) => { %>
  <tr>
    <td style="border:1px solid #000; padding:5px;"><%= it.doc_no %></td>
    <td style="border:1px solid #000; padding:5px;"><%= type %></td>
    <td style="border:1px solid #000; padding:5px;"><%= (it.request_amt || [])[i] ?? '' %></td>
  </tr>
<% }) %>
</table>
<%~ include('/partials/attachments', { attachments: it.attachments, intro: 'To view detail transaction, please click the link below:' }) %>
<%~ include('/partials/signature', it) %>
<%~ include('/partials/approvers', { list: it.approve_list }) %>
